set shell := ["zsh", "-cu"]

# Recipes for the Herder macOS app. Callable from here, or from the repo root as
# `just <recipe> apps/herder`.

name := "Herder"
proj := name + ".xcodeproj"
kit := "HerderKit"

# The syntax-highlighting crate. Its XCFramework is a `.binaryTarget` of
# HerderKit, so it has to exist before SwiftPM will resolve the package at all.
crate := "../../packages/syntax-highlighter"
vendor := kit + "/Vendor"

# `platform=macOS` alone matches both arm64 and x86_64, which makes xcodebuild warn
# that it picked one. Naming this machine's arch keeps the output clean.
arch := `uname -m`
xcodebuild := "xcodebuild -project " + proj + " -scheme " + name + " -destination 'platform=macOS,arch=" + arch + "'"

# Show available recipes
default:
    @just --list --unsorted

# Set up a fresh clone
bootstrap: syntax project
    @echo "Ready. Open {{ proj }}"

# Build the syntax crate and put its XCFramework where HerderKit expects it.
#
# A dependency of every recipe that compiles Swift, because a stale static
# library links without complaint: the app would highlight with yesterday's
# grammars and nothing would say so.
syntax:
    #!/usr/bin/env zsh
    set -euo pipefail
    just --justfile {{ crate }}/justfile --working-directory {{ crate }} build
    mkdir -p {{ vendor }}
    rsync --archive --delete \
        {{ crate }}/target/HerderSyntaxFFI.xcframework {{ vendor }}/

# Check the import rules from docs/ARCHITECTURE.md that the compiler cannot
#
# Target dependencies in Package.swift enforce most of the layering. These are
# the rules that need a grep: what Core may import, what a feature may import,
# and that nothing grows a singleton.
check:
    @scripts/check-boundaries.sh

# Regenerate Herder.xcodeproj from project.yml
project:
    @command -v xcodegen >/dev/null || { print -u2 "xcodegen not found: brew install xcodegen"; exit 1; }
    @xcodegen generate --quiet && echo "Generated {{ proj }}"

# Run the Swift Testing suites (no app host). Goes through xcodebuild rather
# than `swift test`: PhosphorSwift ships its icons as an asset catalog without
# declaring it as a resource, which only Xcode's build system can bundle.
# Extra arguments go to xcodebuild, e.g. `-only-testing:CoreTests`.
#
# `HerderKit` is the scheme Xcode generates for the package, and the name
# depends on how many products the package exports: with several it is
# `HerderKit-Package` instead. If this starts failing with "does not contain a
# scheme", run `xcodebuild -list` in {{ kit }} and use what it prints.
test *args: syntax
    cd {{ kit }} && xcodebuild test -scheme HerderKit -destination 'platform=macOS,arch={{ arch }}' {{ args }}

# Build the app
build: project syntax
    @{{ xcodebuild }} -configuration Debug -quiet build

# Build and run the app, with its output in this terminal
dev: build
    #!/usr/bin/env zsh
    set -euo pipefail

    settings=$({{ xcodebuild }} -configuration Debug -showBuildSettings 2>/dev/null)
    products=$(print -r -- "${settings}" | awk -F' = ' '/ BUILT_PRODUCTS_DIR =/ {print $2; exit}')
    executable=$(print -r -- "${settings}" | awk -F' = ' '/ EXECUTABLE_PATH =/ {print $2; exit}')
    print -P "%F{cyan}==>%f ${executable:t} running. Ctrl-C or Cmd-Q to stop."

    # Ctrl-C reaches this script as well as the app, so trap it, give the app a
    # chance to shut down, and exit 0: ending a dev run is not a failure. The app
    # runs in the background and is waited on so the trap gets a chance to run.
    # `status` is read-only in zsh, hence `code`.
    app_pid=0
    quit() {
        if (( app_pid )); then
            kill -TERM ${app_pid} 2>/dev/null || true
            wait ${app_pid} 2>/dev/null || true
        fi
        exit 0
    }
    trap quit INT TERM HUP

    "${products}/${executable}" &
    app_pid=$!

    set +e
    wait ${app_pid}
    code=$?
    set -e

    # 128+n means the app was signalled rather than quitting on its own.
    if (( code > 128 )); then
        code=0
    fi
    exit ${code}

# Run the XCTest UI suite (slow, launches the app)
uitest: project
    @{{ xcodebuild }} -configuration Debug test

# Open the app in Xcode
open: project
    open {{ proj }}

# Remove build artifacts
clean:
    #!/usr/bin/env zsh
    set -uo pipefail
    # Xcode's background indexer writes into .build the whole time it has the
    # project open, so rm can lose a race with it and report a directory it just
    # emptied as non-empty. Not something to fail a clean over, and not a reason
    # to skip the rest of it.
    rm -rf {{ kit }}/.build {{ vendor }} 2>/dev/null || true
    just --justfile {{ crate }}/justfile --working-directory {{ crate }} clean
    {{ xcodebuild }} clean >/dev/null 2>&1 || true
