{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    // Keeps workflows on full-length SHAs with the version in a trailing
    // comment, which is what .github/AGENTS.md asks for.
    'helpers:pinGitHubActionDigests',
  ],
  schedule: ['before 9am on monday'],
  prConcurrentLimit: 5,
  labels: ['dependencies'],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'ci',
      semanticCommitScope: 'deps',
    },
    // release-please only releases for feat, fix and breaking commits, so
    // these must be `fix` for the shipped app to pick up the new toolchain or
    // lockfile, as it does for a crate bump.
    {
      matchManagers: ['rust-toolchain'],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    // tree-sitter-highlight depends on tree-sitter at the same version, and
    // only one copy of the native library may be linked.
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['tree-sitter', 'tree-sitter-highlight'],
      groupName: 'tree-sitter',
    },
    {
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
    },
  ],
}
