# Generated Xcode projects. project.yml is the source of truth; run `make project`.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# Xcode
xcuserdata/
DerivedData/
build/
*.xcuserstate
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager. Package.resolved stays committed so builds are reproducible.
.build/
.swiftpm/

# Rust build output, and the XCFramework copied out of it. Both are generated
# from packages/herder-syntax-highlighter by `just build apps/herder`.
packages/herder-syntax-highlighter/target/
apps/herder/HerderKit/Vendor/

# libghostty-vt: the downloaded Ghostty source and the XCFramework built from it,
# by `just ghostty` in apps/herder.
packages/herder-ghostty-vt/target/

# Tooling caches
.xcodegen/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Coverage output written by test runs.
*.profraw
